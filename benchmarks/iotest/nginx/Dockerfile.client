# syntax=docker/dockerfile:1.4
FROM ubuntu:22.04

RUN apt-get update && apt-get install -y build-essential \
    wrk vim

WORKDIR /home

COPY <<'EOF' /home/benchmark.sh
#!/bin/bash

#sanity check
LOGDIR=/home/logs
if [ -z "${RUNTIME}" ]; then RUNTIME=runc; fi
echo "RUNTIME:${RUNTIME}"
echo "Arguments: SRV:${SHNAME} - #THREADS:${THR} - #CONNECTIONS:${CON}
- LOGDIR:${LOGDIR}"
CONNECT="http://${SHNAME}/tfile.html"

##check server is ready
TRIES=1000
while [ ${TRIES} -gt 0 ]; do
    if wrk -t1 -c1 -d1s "${CONNECT}" > /dev/null 2>&1; then
        echo "Nginx Server - Ready"
        break
    fi
    TRIES=$((TRIES - 1))
    sleep 1
done

if [ ${TRIES} -eq 0 ]; then echo "Server not found"; exit 1; fi

TEST="-t${THR} -c${CON} -d60s"
#Warm-up
wrk ${TEST} ${CONNECT} > /dev/null
wrk ${TEST} ${CONNECT} > /dev/null

RUNS=40
CSV=${LOGDIR}/${CON}_${RUNTIME}_benchmark_results.csv

SUM=0
RUN_OK=0
for((R=0; R<RUNS; R++)); do
    echo "Test start - Run:${R}"
    sleep 5
    OPUT=$(wrk ${TEST} ${CONNECT} 2>&1)
    RES=$?
    if [ ${RES} -ne 0 ]; then
          echo "Test wrk failed: ${RC} - ${OPUT}"
          continue
    fi

    RPS=$(awk '/Requests\/sec/ {print $2}' <<< "${OPUT}")

    if [[ -z "${RPS}" || ! "${RPS}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
            echo "Test invalid RPS: ${RPS}"
            continue
    fi

    SUM=$(awk -v S="${SUM}" -v V="${RPS}" 'BEGIN {print S+V}')
    RUN_OK=$((RUN_OK + 1))

    echo "Test end - Run:${R}"
done

if [ "${RUN_OK}" -lt 20 ]; then
    echo "Error: not reached limit of successful runs(20)"
    exit 1
fi

AVG=$(awk -v S="${SUM}" -v N="${RUN_OK}" 'BEGIN {printf "%.3f", S/N}')
awk -v rt="${RUNTIME}" -v avg="${AVG}" '
BEGIN {
    print "test," rt
    print "GET," avg
}' > ${CSV}
EOF

RUN chmod +x /home/benchmark.sh

CMD ["/bin/bash", "/home/benchmark.sh"]
